# 이 파일을 .streamlit/secrets.toml로 복사한 뒤 실제 값으로 바꾸세요.
# secrets.toml은 Git에서 제외되며 암호화 저장소가 아니므로 파일 접근 권한으로 보호하세요.
# 같은 키가 환경변수에 있으면 환경변수가 우선합니다.

JIRA_BASE_URL = "https://jira.company.com"           # 실제 Jira 주소(context path 포함)
JIRA_PAT = "REPLACE_WITH_YOUR_PAT"                    # 본인 계정의 개인 액세스 토큰
JIRA_EPIC_TYPE_ID = "REPLACE_WITH_EPIC_TYPE_ID"       # Epic 이슈 유형 숫자 ID
JIRA_TASK_TYPE_IDS = "REPLACE_WITH_TASK_TYPE_ID"      # 포함할 Task 유형 ID, 복수는 쉼표 구분

# 선택 항목
# JIRA_PROJECT_KEYS = "DP,OPS"                        # 비우면 전체 프로젝트
# JIRA_CA_BUNDLE = "C:/certs/company-ca.pem"          # 사내 CA 인증서 경로
# JIRA_EPIC_LINK_FIELD_ID = "customfield_10014"       # Agile Epic API 미지원 시 Epic Link 필드로 조회
# JIRA_CONNECT_TIMEOUT_SECONDS = "5"
# JIRA_READ_TIMEOUT_SECONDS = "10"
# JIRA_COLLECTION_TIMEOUT_SECONDS = "60"
